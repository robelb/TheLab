PORT=3001

# Neon PostgreSQL — https://console.neon.tech
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Brand extraction — OpenAI is used when OPENAI_API_KEY is set; otherwise Gemini.
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation

# Public base URL for customizedImage links written to the catalog
PUBLIC_API_URL=http://localhost:3001

# ── Supabase Storage (optional) ──────────────────────────────────────────────
# When set, uploaded product images and AI-generated photos are stored in
# Supabase Storage instead of on local disk. Leave blank to keep local storage.
# Supabase project → Settings → API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The SERVICE ROLE key (server-side only — never expose to the client).
SUPABASE_SERVICE_ROLE_KEY=
# Bucket name (created automatically as a public bucket if missing).
SUPABASE_STORAGE_BUCKET=product-images

# ── Lead intake webhook (optional) ───────────────────────────────────────────
# Where order and lead events are forwarded for ad-campaign optimisation.
# Leave LEAD_INTAKE_URL blank to keep the queue dormant — events are still
# recorded in `outbound_events`, nothing is sent. Put the token in
# LEAD_INTAKE_TOKEN rather than in the URL so it stays out of logs; it is sent
# as a Bearer header and appended as ?token= for receivers that want it there.
LEAD_INTAKE_URL=
LEAD_INTAKE_TOKEN=
LEAD_INTAKE_TIMEOUT_MS=10000

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Order request received / order confirmed + invoice. Leave RESEND_API_KEY blank
# to keep emails queued in `outbound_events`; setting it later sends them.
# The MAIL_FROM domain must be verified in Resend (DNS records).
RESEND_API_KEY=
MAIL_FROM=big little things <bestellung@biglittlethings.de>
MAIL_REPLY_TO=
# Internal inbox told about every new request (comma-separated).
ORDER_NOTIFY_EMAIL=
# Base URL of the shop, for links in emails (dashboard, shop home).
PUBLIC_SHOP_URL=http://localhost:5173

# ── Invoicing ────────────────────────────────────────────────────────────────
# Printed on every invoice. Invoices cannot be issued until SELLER_NAME,
# SELLER_STREET, SELLER_ZIP, SELLER_CITY, SELLER_IBAN and one of
# SELLER_VAT_ID / SELLER_TAX_NUMBER are set. Name, address, contact, VAT ID,
# register and directors default to our Impressum (src/config/env.ts); leave
# them empty unless they change. The bank details must be set.
VAT_RATE=19
PAYMENT_TERM_DAYS=14
INVOICE_NUMBER_PREFIX=RE
SELLER_NAME=
SELLER_STREET=
SELLER_ZIP=
SELLER_CITY=
SELLER_COUNTRY=Deutschland
SELLER_EMAIL=
SELLER_PHONE=
SELLER_WEBSITE=
SELLER_VAT_ID=
SELLER_TAX_NUMBER=
SELLER_REGISTER_COURT=
SELLER_REGISTER_NUMBER=
SELLER_MANAGING_DIRECTORS=
SELLER_BANK_NAME=
SELLER_IBAN=
SELLER_BIC=

# ── PostHog (optional) ───────────────────────────────────────────────────────
# Server-side events for an order's life after checkout (quoted, confirmed,
# paid, cancelled). Same project token as the client's
# VITE_PUBLIC_POSTHOG_PROJECT_TOKEN. Blank = nothing is sent.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com

# Only for `pnpm analytics:dashboard`, which builds the "Shop analytics"
# dashboard in PostHog. A personal API key (phx_…) from PostHog → Settings →
# Personal API keys, with read + write on insights and dashboards. Never deploy it.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=204810
POSTHOG_APP_HOST=https://eu.posthog.com
