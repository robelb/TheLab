PORT=3001

# ── Database ─────────────────────────────────────────────────────────────────
# Any PostgreSQL with the pgvector extension. Today: Neon (console.neon.tech).
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
# How to talk to it (src/db/index.ts):
#   neon-http — Neon's HTTP driver (default): no connections to keep, suits
#               short-lived servers. Neon only.
#   postgres  — a normal connection pool: any Postgres (Cloud SQL, Neon's
#               -pooler endpoint, Supabase, local). Has real transactions.
DATABASE_DRIVER=neon-http
# Connections in the pool, for DATABASE_DRIVER=postgres. Keep (instances ×
# this) under the database's connection limit.
DATABASE_POOL_SIZE=10

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signs every login token. Required in production (NODE_ENV=production): the
# server refuses to start without a random value of 32+ characters.
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Passwordless "demo" login (a company owner's session for whoever asks).
# Leave off on the live shop; staging only. `pnpm demo:disable` switches the
# account itself off.
DEMO_LOGIN_ENABLED=false
# Extra websites allowed to call the API from a browser in production
# (comma-separated), besides PUBLIC_SHOP_URL. Ignored locally, where any is.
CORS_ORIGINS=
# Proxies in front of the API, so rate limits see visitors' own addresses.
# Cloud Run reached directly (*.run.app or a domain mapping): 1, the production
# default. Behind Firebase Hosting rewrites or an external load balancer: 2.
TRUST_PROXY_HOPS=

# Brand extraction — OpenAI is used when OPENAI_API_KEY is set; otherwise Gemini.
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
# Render resolution for Gemini images: 1K, 2K or 4K (the box photo uses 1K).
GEMINI_IMAGE_SIZE=2K

# The API's own public address (links to files it serves). Required in
# production as the real https address, e.g. https://api.biglittlethings.de.
PUBLIC_API_URL=http://localhost:3001

# ── Supabase Storage (required in production) ────────────────────────────────
# Uploaded logos, product images and AI-generated photos. Locally they fall
# back to the disk when these are blank; production refuses to start without
# them, because a container's disk is wiped on every restart.
# Supabase project → Settings → API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The SERVICE ROLE key (server-side only — never expose to the client).
SUPABASE_SERVICE_ROLE_KEY=
# Bucket name (created automatically as a public bucket if missing).
SUPABASE_STORAGE_BUCKET=product-images

# ── Lead intake webhook (optional) ───────────────────────────────────────────
# Where order and lead events are forwarded for ad-campaign optimisation.
# Leave LEAD_INTAKE_URL blank to keep the queue dormant — events are still
# recorded in `outbound_events`, nothing is sent. Put the token in
# LEAD_INTAKE_TOKEN rather than in the URL so it stays out of logs; it is sent
# as a Bearer header and appended as ?token= for receivers that want it there.
LEAD_INTAKE_URL=
LEAD_INTAKE_TOKEN=
LEAD_INTAKE_TIMEOUT_MS=10000

# ── Email ────────────────────────────────────────────────────────────────────
# Order request received / order confirmed + invoice / new-request alert.
# Every email is queued in `outbound_events` first and sent from there, with
# retries for about two days.
#
# Which provider sends them (src/services/mail/): smtp, resend or log.
#   log — prints emails to the server log instead of sending (local/staging).
# Left blank: smtp when SMTP_HOST is set, otherwise resend. A provider that is
# not configured keeps emails queued; configuring it later sends them.
MAIL_PROVIDER=
#
# SMTP — any mailbox, no domain to verify. For Gmail: turn on 2-step
# verification, create an app password (Google Account → Security → App
# passwords) and put it in SMTP_PASS — your normal password will not work.
# Gmail sends as SMTP_USER; the name in MAIL_FROM is kept. ~500 emails/day.
SMTP_HOST=
# SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
#
# Resend — the MAIL_FROM domain must be verified in Resend (DNS records);
# until then it only delivers to the Resend account's own address.
RESEND_API_KEY=
MAIL_FROM=big little things <bestellung@biglittlethings.de>
MAIL_REPLY_TO=
# Most box/bundle photos generated per day per server (a backstop on the AI
# bill if the per-visitor limits are ever got round). Default 500.
AI_DAILY_IMAGE_LIMIT=500
# Lets Cloud Scheduler send queued emails on a host that idles between
# requests: it calls POST /internal/outbox/flush with
# "Authorization: Bearer <this>". Any long random string; blank turns it off.
OUTBOX_FLUSH_TOKEN=
# Internal inbox told about every new request (comma-separated). Only a
# starting value: once the list is saved in the dashboard (Admin →
# Notifications) that one is used instead.
ORDER_NOTIFY_EMAIL=
# Base URL of the shop and its dashboard, for links in emails ("Open in
# dashboard"). Locally defaults to http://localhost:5173. Required in
# production (NODE_ENV=production) and must be the public https address,
# e.g. https://thelab-001.web.app — the server will not start without it.
PUBLIC_SHOP_URL=http://localhost:5173

# ── Invoicing ────────────────────────────────────────────────────────────────
# Printed on every invoice. Invoices cannot be issued until SELLER_NAME,
# SELLER_STREET, SELLER_ZIP, SELLER_CITY, SELLER_IBAN and one of
# SELLER_VAT_ID / SELLER_TAX_NUMBER are set. Name, address, contact, VAT ID,
# register and directors default to our Impressum (src/config/env.ts); leave
# them empty unless they change. The bank details must be set.
VAT_RATE=19
PAYMENT_TERM_DAYS=14
INVOICE_NUMBER_PREFIX=RE
SELLER_NAME=
SELLER_STREET=
SELLER_ZIP=
SELLER_CITY=
SELLER_COUNTRY=Deutschland
SELLER_EMAIL=
SELLER_PHONE=
SELLER_WEBSITE=
SELLER_VAT_ID=
SELLER_TAX_NUMBER=
SELLER_REGISTER_COURT=
SELLER_REGISTER_NUMBER=
SELLER_MANAGING_DIRECTORS=
SELLER_BANK_NAME=
SELLER_IBAN=
SELLER_BIC=

# ── PostHog (optional) ───────────────────────────────────────────────────────
# Server-side events for an order's life after checkout (quoted, confirmed,
# paid, cancelled). Same project token as the client's
# VITE_PUBLIC_POSTHOG_PROJECT_TOKEN. Blank = nothing is sent.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com

# Only for `pnpm analytics:dashboard`, which builds the "Shop analytics"
# dashboard in PostHog. A personal API key (phx_…) from PostHog → Settings →
# Personal API keys, with read + write on insights and dashboards. Never deploy it.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=204810
POSTHOG_APP_HOST=https://eu.posthog.com
