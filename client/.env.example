# Backend origin (no trailing slash). Required for production builds.
# Local dev: http://localhost:3001 — Vite also proxies /api when using pnpm dev
# Production: https://your-api.onrender.com (set in Render/Firebase build env)
VITE_API_URL=http://localhost:3001

# What the version badge calls this build. Leave unset and it works itself out:
# the dev server and `pnpm build:testing` say "testing", a plain `pnpm build`
# says "production" (and the badge drops the label). Set it to override — e.g.
# VITE_APP_ENV=staging, or VITE_APP_ENV=testing to label every build for testers.
# VITE_APP_ENV=testing

# Privacy policy linked from the checkout consent checkbox.
# VITE_PRIVACY_URL=https://biglittlethings.de/datenschutz/
