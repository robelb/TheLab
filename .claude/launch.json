{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "client",
        "dev:web"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "backend",
        "dev"
      ],
      "port": 3009
    },
    {
      "name": "api-e2e",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "MAIL_PROVIDER=log",
        "pnpm",
        "--dir",
        "backend",
        "dev"
      ],
      "port": 3009
    }
  ]
}
